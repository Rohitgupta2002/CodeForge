# Existing application settings
PORT=3000
DB_CONNECT_STRING=
JWT_KEY=
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=

# Free public Judge0 CE endpoint. It has no availability guarantee, so use it
# for learning/development and keep requests modest.
JUDGE0_PROVIDER=public

# Optional: only needed when JUDGE0_PROVIDER=rapidapi.
JUDGE0_KEY=

# Optional: tune polling for your Judge0/RapidAPI plan.
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLL_ATTEMPTS=20
